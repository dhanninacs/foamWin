#!/bin/sh
cd ${0%/*} || exit 1    # Run from this directory

# Parse arguments for library compilation
. $WM_PROJECT_DIR/wmake/scripts/AllwmakeParseArguments

wmake $targetType basic
wmake $targetType solidParticle
wmake $targetType parcel
wmake $targetType DSMC
wmake $targetType molecularDynamics

# Windows file names ignore case, so liblagrangianFunctionObjects would clash
# with libLagrangianFunctionObjects from src/Lagrangian
[ "$WM_ARCH" = linuxmingw-w64 ] || wmake $targetType functionObjects

